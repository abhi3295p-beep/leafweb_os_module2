generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  passwordHash           String
  name                   String
  emailVerifiedAt        DateTime?
  image                  String?
  roleId                 String
  lastLoginAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  activityEvents         ActivityEvent[]         @relation("ActivityActor")
  auditLogs              AuditLog[]              @relation("AuditActor")
  client                 Client?
  uploadedFiles          FileObject[]            @relation("FileUploader")
  messages               Message[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  orders                 Order[]                 @relation("OrderCreatedBy")
  projectMemberships     ProjectMember[]
  sessions               Session[]
  assignedTasks          Task[]                  @relation("TaskAssignee")
  teamMember             TeamMember?
  role                   Role                    @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([deletedAt])
}

model Client {
  id          String       @id @default(uuid())
  userId      String       @unique
  companyName String?
  phone       String?
  website     String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  user        User         @relation(fields: [userId], references: [id])
  files       FileObject[]
  invoices    Invoice[]
  leads       Lead[]
  messages    Message[]
  orders      Order[]
  payments    Payment[]
  projects    Project[]

  @@index([deletedAt])
}

model TeamMember {
  id                 String          @id @default(uuid())
  userId             String          @unique
  title              String?
  department         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  projectMemberships ProjectMember[]
  user               User            @relation(fields: [userId], references: [id])
}

model Role {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  tokenHash  String   @unique
  type       String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model Service {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  summary       String
  description   String
  features      String[]
  technologies  String[]
  timeline      String?
  startingPrice Decimal?  @db.Decimal(12, 2)
  currency      String    @default("INR")
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  leads         Lead[]
  orders        Order[]
  packages      Package[]

  @@index([isActive, sortOrder])
}

model Package {
  id          String    @id @default(uuid())
  serviceId   String
  name        String
  description String
  price       Decimal   @db.Decimal(12, 2)
  currency    String    @default("INR")
  features    String[]
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  orders      Order[]
  service     Service   @relation(fields: [serviceId], references: [id])

  @@index([serviceId, isActive])
}

model Lead {
  id                 String     @id @default(uuid())
  name               String
  email              String
  phone              String?
  company            String?
  website            String?
  industry           String?
  location           String?
  message            String
  source             String?
  status             LeadStatus @default(NEW)
  qualification      String?
  qualificationScore Int?
  assignedToId       String?
  notes              String?
  nextFollowUpAt     DateTime?
  lastContactedAt    DateTime?
  contactAttempts    Int        @default(0)
  serviceId          String?
  clientId           String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  client     Client?        @relation(fields: [clientId], references: [id])
  service    Service?       @relation(fields: [serviceId], references: [id])
  activities LeadActivity[]

  @@index([status])
  @@index([email])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
}

model Order {
  id          String      @id @default(uuid())
  clientId    String
  createdById String
  serviceId   String
  packageId   String?
  description String
  budget      Decimal?    @db.Decimal(12, 2)
  deadline    DateTime?
  features    String[]
  references  String?
  notes       String?
  status      OrderStatus @default(SUBMITTED)
  convertedAt DateTime?
  projectId   String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  messages    Message[]
  client      Client      @relation(fields: [clientId], references: [id])
  createdBy   User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  package     Package?    @relation(fields: [packageId], references: [id])
  project     Project?    @relation("ProjectOrder", fields: [projectId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])
  files       OrderFile[]

  @@index([clientId, status])
  @@index([status])
}

model OrderFile {
  id           String     @id @default(uuid())
  orderId      String
  fileObjectId String
  createdAt    DateTime   @default(now())
  fileObject   FileObject @relation(fields: [fileObjectId], references: [id])
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, fileObjectId])
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String
  clientId    String
  budget      Decimal?        @db.Decimal(12, 2)
  startDate   DateTime?
  dueDate     DateTime?
  status      ProjectStatus   @default(NEW)
  progress    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  activity    ActivityEvent[]
  files       FileObject[]
  invoices    Invoice[]
  messages    Message[]
  milestones  Milestone[]
  order       Order?          @relation("ProjectOrder")
  client      Client          @relation(fields: [clientId], references: [id])
  members     ProjectMember[]
  tasks       Task[]

  @@index([clientId, status])
  @@index([status])
  @@index([deletedAt])
}

model ProjectMember {
  id           String      @id @default(uuid())
  projectId    String
  userId       String
  teamMemberId String?
  createdAt    DateTime    @default(now())
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  name        String
  description String?
  status      MilestoneStatus @default(PENDING)
  progress    Int             @default(0)
  sortOrder   Int             @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, sortOrder])
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  milestoneId String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([assigneeId])
}

model FileObject {
  id           String         @id @default(uuid())
  storageKey   String         @unique
  originalName String
  mimeType     String
  extension    String
  sizeBytes    Int
  driver       FileDriver     @default(LOCAL)
  visibility   FileVisibility @default(PRIVATE)
  checksum     String?
  uploadedById String
  clientId     String?
  projectId    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  client       Client?        @relation(fields: [clientId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id])
  uploadedBy   User           @relation("FileUploader", fields: [uploadedById], references: [id])
  orderFiles   OrderFile[]

  @@index([clientId])
  @@index([projectId])
  @@index([uploadedById])
}

model Message {
  id        String    @id @default(uuid())
  body      String
  senderId  String
  clientId  String?
  projectId String?
  orderId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  client    Client?   @relation(fields: [clientId], references: [id])
  order     Order?    @relation(fields: [orderId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])
  sender    User      @relation(fields: [senderId], references: [id])

  @@index([projectId, createdAt])
  @@index([orderId, createdAt])
  @@index([clientId, createdAt])
}

model Notification {
  id           String    @id @default(uuid())
  userId       String
  type         String
  title        String
  body         String
  resourceType String?
  resourceId   String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String        @id @default(uuid())
  number    String        @unique
  clientId  String
  projectId String?
  status    InvoiceStatus @default(DRAFT)
  subtotal  Decimal       @db.Decimal(12, 2)
  tax       Decimal       @default(0) @db.Decimal(12, 2)
  total     Decimal       @db.Decimal(12, 2)
  currency  String        @default("INR")
  issuedAt  DateTime?
  dueAt     DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  client    Client        @relation(fields: [clientId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id])
  payments  Payment[]

  @@index([clientId, status])
}

model Payment {
  id             String              @id @default(uuid())
  invoiceId      String
  clientId       String
  amount         Decimal             @db.Decimal(12, 2)
  currency       String              @default("INR")
  status         PaymentStatus       @default(PENDING)
  provider       PaymentProviderKind @default(MANUAL)
  providerRef    String?
  idempotencyKey String?             @unique
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  client         Client              @relation(fields: [clientId], references: [id])
  invoice        Invoice             @relation(fields: [invoiceId], references: [id])

  @@index([clientId, status])
  @@index([invoiceId])
}

model ActivityEvent {
  id           String   @id @default(uuid())
  type         String
  summary      String
  projectId    String?
  actorId      String?
  resourceType String?
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("ActivityActor", fields: [actorId], references: [id])
  project      Project? @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  actorId      String?
  ipAddress    String?
  userAgent    String?
  resourceType String?
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
}

model AgencySetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectStatus {
  NEW
  REQUIREMENTS
  PLANNING
  DESIGN
  DEVELOPMENT
  TESTING
  CLIENT_REVIEW
  REVISIONS
  DEPLOYMENT
  COMPLETED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProviderKind {
  STRIPE
  RAZORPAY
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING_BOOKED
  PROPOSAL
  PROPOSAL_SENT
  WON
  LOST
}

enum FileVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum FileDriver {
  LOCAL
  S3
  R2
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  type      String
  summary   String
  details   String?
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model AIEmployee {
  id            String   @id @default(uuid())
  name          String
  type          String
  displayName   String
  description   String?
  capabilities  Json
  configuration Json
  status        String   @default("IDLE")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks        AITask[]
  activityLogs AIActivityLog[]
  approvals    AIApproval[]

  @@index([type])
  @@index([isActive])
  @@index([status])
}

model AITask {
  id               String    @id @default(uuid())
  aiEmployeeId     String
  taskType         String
  priority         Int       @default(0)
  resourceType     String?
  resourceId       String?
  input            Json?
  requiresApproval Boolean   @default(false)
  scheduledFor     DateTime?
  status           String    @default("PENDING")
  startedAt        DateTime?
  completedAt      DateTime?
  output           Json?
  result           String?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  aiEmployee AIEmployee  @relation(fields: [aiEmployeeId], references: [id], onDelete: Cascade)
  approval   AIApproval?

  @@index([aiEmployeeId])
  @@index([status])
  @@index([scheduledFor])
  @@index([resourceType, resourceId])
}

model AIActivityLog {
  id           String   @id @default(uuid())
  aiEmployeeId String
  action       String
  summary      String
  metadata     Json?
  createdAt    DateTime @default(now())

  aiEmployee AIEmployee @relation(fields: [aiEmployeeId], references: [id], onDelete: Cascade)

  @@index([aiEmployeeId])
  @@index([createdAt])
}

model AIApproval {
  id                String    @id @default(uuid())
  taskId            String    @unique
  aiEmployeeId      String
  requiredApprovers String[]
  status            String    @default("PENDING")
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  task       AITask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  aiEmployee AIEmployee @relation(fields: [aiEmployeeId], references: [id], onDelete: Cascade)

  @@index([aiEmployeeId])
  @@index([status])
}
