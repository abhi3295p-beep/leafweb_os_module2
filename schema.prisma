generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  NEW
  REQUIREMENTS
  PLANNING
  DESIGN
  DEVELOPMENT
  TESTING
  CLIENT_REVIEW
  REVISIONS
  DEPLOYMENT
  COMPLETED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProviderKind {
  STRIPE
  RAZORPAY
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum FileVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum FileDriver {
  LOCAL
  S3
  R2
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  name             String
  emailVerifiedAt  DateTime?
  image            String?
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  client           Client?
  teamMember       TeamMember?
  sessions         Session[]
  orders           Order[]           @relation("OrderCreatedBy")
  projectMemberships ProjectMember[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  uploadedFiles    FileObject[]      @relation("FileUploader")
  messages         Message[]
  notifications    Notification[]
  notificationPreference NotificationPreference?
  activityEvents   ActivityEvent[]   @relation("ActivityActor")
  auditLogs        AuditLog[]        @relation("AuditActor")

  @@index([roleId])
  @@index([deletedAt])
}

model Client {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  companyName String?
  phone       String?
  website     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  leads       Lead[]
  orders      Order[]
  projects    Project[]
  invoices    Invoice[]
  payments    Payment[]
  files       FileObject[]
  messages    Message[]

  @@index([deletedAt])
}

model TeamMember {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  title     String?
  department String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projectMemberships ProjectMember[]
}

model Role {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String   @id @default(uuid())
  identifier String
  tokenHash String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([identifier, type])
}

model Service {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  summary       String
  description   String
  features      String[]
  technologies  String[]
  timeline      String?
  startingPrice Decimal?  @db.Decimal(12, 2)
  currency      String    @default("INR")
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  packages Package[]
  leads    Lead[]
  orders   Order[]

  @@index([isActive, sortOrder])
}

model Package {
  id          String    @id @default(uuid())
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id])
  name        String
  description String
  price       Decimal   @db.Decimal(12, 2)
  currency    String    @default("INR")
  features    String[]
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  orders Order[]

  @@index([serviceId, isActive])
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  email       String
  phone       String?
  company     String?
  message     String
  status      LeadStatus @default(NEW)
  serviceId   String?
  service     Service?   @relation(fields: [serviceId], references: [id])
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([status])
  @@index([email])
}

model Order {
  id            String      @id @default(uuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  createdById   String
  createdBy     User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  packageId     String?
  package       Package?    @relation(fields: [packageId], references: [id])
  description   String
  budget        Decimal?    @db.Decimal(12, 2)
  deadline      DateTime?
  features      String[]
  references    String?
  notes         String?
  status        OrderStatus @default(SUBMITTED)
  convertedAt   DateTime?
  projectId     String?     @unique
  project       Project?    @relation("ProjectOrder", fields: [projectId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  files    OrderFile[]
  messages Message[]

  @@index([clientId, status])
  @@index([status])
}

model OrderFile {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileObjectId String
  fileObject   FileObject @relation(fields: [fileObjectId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([orderId, fileObjectId])
}

model Project {
  id          String         @id @default(uuid())
  name        String
  description String
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  order       Order?         @relation("ProjectOrder")
  budget      Decimal?       @db.Decimal(12, 2)
  startDate   DateTime?
  dueDate     DateTime?
  status      ProjectStatus  @default(NEW)
  progress    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  members     ProjectMember[]
  milestones  Milestone[]
  tasks       Task[]
  files       FileObject[]
  messages    Message[]
  invoices    Invoice[]
  activity    ActivityEvent[]

  @@index([clientId, status])
  @@index([status])
  @@index([deletedAt])
}

model ProjectMember {
  id           String     @id @default(uuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  teamMemberId String?
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      MilestoneStatus  @default(PENDING)
  progress    Int              @default(0)
  sortOrder   Int              @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  tasks Task[]

  @@index([projectId, sortOrder])
}

model Task {
  id           String     @id @default(uuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId  String?
  milestone    Milestone? @relation(fields: [milestoneId], references: [id])
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  assigneeId   String?
  assignee     User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@index([projectId, status])
  @@index([assigneeId])
}

model FileObject {
  id           String         @id @default(uuid())
  storageKey   String         @unique
  originalName String
  mimeType     String
  extension    String
  sizeBytes    Int
  driver       FileDriver     @default(LOCAL)
  visibility   FileVisibility @default(PRIVATE)
  checksum     String?
  uploadedById String
  uploadedBy   User           @relation("FileUploader", fields: [uploadedById], references: [id])
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id])
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  orderFiles OrderFile[]

  @@index([clientId])
  @@index([projectId])
  @@index([uploadedById])
}

model Message {
  id         String   @id @default(uuid())
  body       String
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@index([projectId, createdAt])
  @@index([orderId, createdAt])
  @@index([clientId, createdAt])
}

model Notification {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  title        String
  body         String
  resourceType String?
  resourceId   String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id          String        @id @default(uuid())
  number      String        @unique
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  status      InvoiceStatus @default(DRAFT)
  subtotal    Decimal       @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  currency    String        @default("INR")
  issuedAt    DateTime?
  dueAt       DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  payments Payment[]

  @@index([clientId, status])
}

model Payment {
  id              String               @id @default(uuid())
  invoiceId       String
  invoice         Invoice              @relation(fields: [invoiceId], references: [id])
  clientId        String
  client          Client               @relation(fields: [clientId], references: [id])
  amount          Decimal              @db.Decimal(12, 2)
  currency        String               @default("INR")
  status          PaymentStatus        @default(PENDING)
  provider        PaymentProviderKind  @default(MANUAL)
  providerRef     String?
  idempotencyKey  String?              @unique
  paidAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([clientId, status])
  @@index([invoiceId])
}

model ActivityEvent {
  id           String   @id @default(uuid())
  type         String
  summary      String
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  actorId      String?
  actor        User?    @relation("ActivityActor", fields: [actorId], references: [id])
  resourceType String?
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  ipAddress    String?
  userAgent    String?
  resourceType String?
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
}

model AgencySetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
