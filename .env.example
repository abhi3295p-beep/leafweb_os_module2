NODE_ENV=staging
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=leafweb_os
POSTGRES_PORT=5432
DATABASE_URL="postgresql://app_user:change_me@staging-db-host:5432/leafweb_os?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
APP_URL="https://staging.example.com"
FILE_DRIVER="s3"
FILE_LOCAL_DIR="./storage/uploads"
S3_ENDPOINT_URL="https://s3.example.com"
S3_BUCKET_NAME="leafweb-staging-files"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="replace-with-s3-access-key"
S3_SECRET_ACCESS_KEY="replace-with-s3-secret-key"
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-secret"
AI_TOOL_ALLOWLIST="lead_search,project_status,task_update,file_download"
SUPER_ADMIN_EMAIL="admin@staging.example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-long-random-password-min-12-chars"
SUPER_ADMIN_NAME="LeafWeb Super Admin"
